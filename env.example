# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# Never commit your real .env — it holds secret keys.
# ---------------------------------------------------------------------------

# --- Anthropic (Claude) ----------------------------------------------------
# Get a key at https://console.anthropic.com  -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Confirm the current vision-capable model ID at:
#   https://docs.claude.com/en/docs/about-claude/models
# and paste it here. This must be a model that accepts images.
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Twilio (SMS) ----------------------------------------------------------
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The Twilio phone number (or Messaging Service SID) that sends the texts.
# Use either TWILIO_FROM_NUMBER *or* TWILIO_MESSAGING_SERVICE_SID (not both).
TWILIO_FROM_NUMBER=+15555550123
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Snappic webhook security ----------------------------------------------
# A shared secret used to verify incoming webhooks are really from Snappic.
# See README section "Securing the webhooks" — confirm Snappic's exact method
# and set the mode below to match.
SNAPPIC_WEBHOOK_SECRET=choose-a-long-random-string
# Verification mode: "hmac" | "token" | "none"
#   hmac  = Snappic signs the request body; we recompute and compare (best).
#   token = Snappic sends the secret in a header; we compare it (simple).
#   none  = no verification (ONLY for local testing — never in production).
SNAPPIC_VERIFY_MODE=token
# Header name Snappic uses to send the signature/token.
SNAPPIC_SIGNATURE_HEADER=X-Snappic-Signature

# --- Message wording -------------------------------------------------------
# Prefix shown before the description in the SMS the guest receives.
# Keep it short and screen-reader friendly.
SMS_PREFIX=Photo description:
# Optional event/brand name appended for context. Leave blank to omit.
EVENT_NAME=

# --- Admin dashboard -------------------------------------------------------
# The staff dashboard at /admin is protected with HTTP Basic auth.
# Set a password to enable it (leave blank to disable the dashboard entirely).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-staff-password

# --- App / database --------------------------------------------------------
# SQLite by default (a file). For production you can point this at Postgres,
# e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./snappic_alt_text.db
# Where downloaded media is temporarily cached before captioning.
MEDIA_TMP_DIR=./_media_tmp
LOG_LEVEL=INFO
